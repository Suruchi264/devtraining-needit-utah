        <api_name>x_58872_needit.Find Overdue NeedIt Tasks</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Find NeedIt Tasks Due Soon</description>
        <mobile_callable>false</mobile_callable>
        <name>Find Overdue NeedIt Tasks</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[// Get current date and time
var rightNow = new GlideDateTime();

// Create a new GlideDateTime object for 24 hours from now
var next24Hours = new GlideDateTime();
next24Hours.addDays(1);   // Adds 24 hours

// Query the NeedIt Task table
var upcomingNITasks = new GlideRecord('x_58872_needit_needit_task');

// Due date should be BETWEEN now and next 24 hours
upcomingNITasks.addQuery('due_date', '>=', rightNow);
upcomingNITasks.addQuery('due_date', '<=', next24Hours);

// Exclude Closed Complete tasks (state = 3)
upcomingNITasks.addQuery('state', '!=', 3);

upcomingNITasks.query();

// Log each matching record
while (upcomingNITasks.next()) {
  gs.info("NeedIt Task due within 24 hours = " + upcomingNITasks.number);
}
]]></script>
